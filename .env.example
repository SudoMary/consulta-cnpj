# Copie para .env e ajuste se necessário. Nenhum segredo real aqui.

# Fonte primária
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# Fonte de fallback
MINHARECEITA_BASE_URL=https://minhareceita.org

# Cache
CACHE_TTL_HORAS=24

# HTTP
HTTP_TIMEOUT_SEGUNDOS=8

# Banco: SQLite local por padrão. Em produção, a connection string do Supabase
# no modo "Session pooler", guardada como segredo da hospedagem, nunca aqui.
DATABASE_URL=sqlite:///./dados/consulta_cnpj.db

# Assistente (opcional): sem a chave, ele fica desligado. A chave é criada em
# console.anthropic.com e, como a senha do banco, nunca vai para o repositório.
# ANTHROPIC_API_KEY=
ASSISTENTE_MODELO=claude-opus-5-5
# Perguntas por dia, no horário de Brasília. Cada uma custa dinheiro e o site não tem login.
ASSISTENTE_LIMITE_DIARIO=20

# Opcional: PostgreSQL para rodar os testes de banco também nele (o CI sempre roda).
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
